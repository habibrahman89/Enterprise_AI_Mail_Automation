# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the resulting .env file to source control.
# ============================================================

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

ADMIN_USERNAME=admin
# Must be changed before first run in any shared/production environment.
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

DATABASE_URL=sqlite:///enterprise_mail_ai.db

MAIL_PROVIDER=gmail
SYNC_LIMIT=100
HOST=127.0.0.1
PORT=5000

# 1 = local development only (enables Werkzeug debugger, verbose errors).
# MUST be 0 outside of local development.
FLASK_DEBUG=0

# 1 = allow OAuth over plain HTTP. LOCAL DEVELOPMENT ONLY.
# Leave 0 (or unset) whenever HOST is anything but 127.0.0.1/localhost.
OAUTH_INSECURE_TRANSPORT=0

# Set to 1 once the app is served over HTTPS, so session cookies require it.
SESSION_COOKIE_SECURE=0

GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b

GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

OUTLOOK_CLIENT_ID=YOUR_ENTRA_APP_CLIENT_ID
OUTLOOK_TENANT_ID=common
OUTLOOK_TOKEN_FILE=outlook_token_cache.json

GOOGLE_CLIENT_SECRETS_FILE=google_client_secret.json
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/google/callback

SCHEDULER_ENABLED=0
SCHEDULE_MINUTES=15
SCHEDULE_SYNC_LIMIT=50

ATTACHMENT_STORAGE=storage/attachments
# Reject attachments larger than this before extraction/storage.
ATTACHMENT_MAX_SIZE_MB=25

OCR_ENABLED=0

# Requests per minute allowed on /login before rate limiting kicks in.
LOGIN_RATE_LIMIT=10/minute
